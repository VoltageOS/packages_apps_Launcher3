<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quickspace_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="start|top"
    android:orientation="vertical"
    android:paddingTop="44dp">

    <TextView
        android:id="@+id/quickspace_day_of_week"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="google-sans-medium"
        android:paddingStart="16dp"
        android:textColor="?workspaceTextColor"
        android:textSize="28sp"
        android:textStyle="normal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.android.launcher3.quickspace.views.AccentedTextClock
        android:id="@+id/quickspace_clock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="none"
        android:fontFamily="google-sans-flex"
        android:format12Hour="h:mm"
        android:format24Hour="H:mm"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:textColor="?workspaceTextColor"
        android:textSize="80sp"
        app:layout_constraintEnd_toStartOf="@id/quickspace_weather_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/quickspace_day_of_week" />

    <TextView
        android:id="@+id/quickspace_date"
        style="@style/QuickSpaceSubText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="google-sans-flex"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:textColor="?workspaceTextColor"
        android:textSize="@dimen/quickspace_subtitle_size"
        app:layout_constraintEnd_toStartOf="@id/quickspace_weather_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/quickspace_clock" />

    <View
        android:id="@+id/quickspace_weather_divider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@android:color/white"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/quickspace_clock"
        app:layout_constraintEnd_toStartOf="@id/quick_event_weather_content"
        app:layout_constraintStart_toEndOf="@id/quickspace_clock"
        app:layout_constraintTop_toTopOf="@id/quickspace_clock" />

    <include
        android:id="@+id/quick_event_weather_content"
        layout="@layout/quickspace_weather_content_paged"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/quickspace_clock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/quickspace_weather_divider"
        app:layout_constraintTop_toTopOf="@id/quickspace_clock" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/date_weather_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="quickspace_date,quick_event_weather_content" />

    <include
        layout="@layout/quickspace_calendar_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/date_weather_barrier" />

    <include
        android:id="@+id/quickspace_minimal_icons_row"
        layout="@layout/quickspace_minimal_icons_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/quickspace_calendar_content" />

    <include
        android:id="@+id/quickspace_weather_expanded_row"
        layout="@layout/quickspace_weather_expanded_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/quickspace_minimal_icons_row" />

    <FrameLayout
        android:id="@+id/contextual_info_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/quickspace_weather_expanded_row">

        <LinearLayout
            android:id="@+id/now_playing_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/now_playing_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_music_note_24dp"
                android:tint="?workspaceTextColor" />

            <TextView
                android:id="@+id/now_playing_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="google-sans-flex"
                android:singleLine="true"
                android:textColor="?workspaceTextColor"
                android:textSize="@dimen/quickspace_subtitle_size" />
        </LinearLayout>

        <TextView
            android:id="@+id/quickspace_psa_message"
            style="@style/QuickSpaceSubText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="google-sans-flex"
            android:textColor="?workspaceTextColor"
            android:textSize="@dimen/quickspace_subtitle_size"
            android:visibility="gone" />

    </FrameLayout>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/expanded_content_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="quickspace_calendar_content,quickspace_minimal_icons_row,quickspace_weather_expanded_row,contextual_info_row" />

    <FrameLayout
        android:id="@+id/battery_info_row"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_battery_pill"
        android:clipChildren="false"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/expanded_content_barrier">

        <FrameLayout
            android:id="@+id/battery_progress_bar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_battery_progress"
            android:clipToOutline="true">

            <View
                android:id="@+id/battery_shimmer_view"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_battery_shimmer"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/battery_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:alpha="0.6"
                    android:src="@drawable/ic_battery_std"
                    android:tint="?workspaceTextColor" />

                <ImageView
                    android:id="@+id/battery_charging_overlay"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="bottom|end"
                    android:alpha="0.8"
                    android:elevation="1dp"
                    android:src="@drawable/ic_bolt_mini"
                    android:tint="?workspaceTextColor"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/battery_device_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="google-sans-medium"
                android:singleLine="true"
                android:textColor="?workspaceTextColor"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/battery_percentage"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:background="@drawable/bg_battery_level_tag"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textColor="?android:attr/textColorPrimaryInverse"
                android:textSize="12sp"
                android:fontFamily="google-sans-medium" />

            <LinearLayout
                android:id="@+id/battery_dots_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
