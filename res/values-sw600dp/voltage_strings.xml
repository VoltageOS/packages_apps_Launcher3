<!-- On tablets the toggle meaning is inverted: enabling it switches FROM
     tablet style TO phone style. Override labels here to reflect that. -->
<resources>
    <string name="pref_tablet_overview_style_title">Use phone overview style (Needs restart)</string>
    <string name="pref_tablet_overview_style_summary_on">Using phone style for overview/recents</string>
    <string name="pref_tablet_overview_style_summary_off">Using tablet style for overview/recents</string>
</resources>
